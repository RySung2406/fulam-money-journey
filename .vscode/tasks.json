{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Fulin: start website",
      "type": "npm",
      "script": "dev",
      "isBackground": true,
      "problemMatcher": {
        "owner": "fulin",
        "pattern": {
          "regexp": "^(.*):(\\d+):(\\d+):\\s*(.*)$",
          "file": 1,
          "line": 2,
          "column": 3,
          "message": 4
        },
        "background": {
          "activeOnStart": true,
          "beginsPattern": "^Starting Fulin development server",
          "endsPattern": "^Fulin development server ready:"
        }
      },
      "presentation": { "reveal": "always", "panel": "dedicated" }
    },
    {
      "label": "Fulin: build for deployment",
      "type": "npm",
      "script": "bundle",
      "group": { "kind": "build", "isDefault": true },
      "problemMatcher": []
    },
    {
      "label": "Fulin: test",
      "type": "npm",
      "script": "test",
      "group": { "kind": "test", "isDefault": true },
      "problemMatcher": []
    },
    {
      "label": "Fulin: check syntax",
      "type": "npm",
      "script": "check",
      "problemMatcher": []
    }
  ]
}
